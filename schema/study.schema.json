{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connorwhite-online/loadpath/schema/study.schema.json",
  "title": "loadpath study",
  "description": "A generative design (topology optimization) problem. Units: mm, N, MPa, g/cm\u00b3.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Used to name the output files."
    },
    "description": {
      "type": "string"
    },
    "designSpace": {
      "anyOf": [
        {
          "$ref": "#/$defs/shape"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 1
        }
      ],
      "description": "Shapes material may occupy (their union)."
    },
    "preserve": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "description": "Geometry kept exactly: bosses, mounting faces."
    },
    "keepOut": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keepOut"
      },
      "description": "Volume that must stay empty: bores, bolt access, cables, mating parts."
    },
    "fasteners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fastener"
      }
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      },
      "description": "Where the part is held. Required unless every load is a pressure."
    },
    "skin": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "properties": {
            "thickness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "open": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?[xyz]$"
              },
              "description": "design-space faces left without skin, like '-z' (where ribs stand on a cover's inside)"
            }
          },
          "required": [
            "thickness"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Skin-and-rib: mm of the design space's outer surface kept as a solid wall; the optimizer designs the ribs behind it."
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loadCase"
      },
      "minItems": 1
    },
    "loads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/load"
      },
      "description": "Shorthand for a single load case."
    },
    "material": {
      "anyOf": [
        {
          "$ref": "#/$defs/material"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          },
          "minItems": 1
        }
      ],
      "description": "A list solves the goal in each and pools the outcomes."
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "minMember": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Thinnest member, mm."
    },
    "symmetry": {
      "type": "array",
      "items": {
        "enum": [
          "x",
          "y",
          "z"
        ]
      },
      "description": "Planes through the design-space centre, by normal axis."
    },
    "resolution": {
      "type": "object",
      "properties": {
        "maxElements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400000
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "maxIterations": {
      "type": "integer",
      "minimum": 1
    },
    "gravity": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "m/s\u00b2, the part's own weight in every load case"
    },
    "printDirection": {
      "type": "string",
      "pattern": "^[+-]?[xyz]$",
      "description": "The direction layers stack; turns on overhang control."
    },
    "extrusion": {
      "type": "string",
      "pattern": "^[+-]?[xyz]$",
      "description": "The part is a profile extruded along this axis (cut from plate)."
    },
    "process": {
      "anyOf": [
        {
          "enum": [
            "fdm",
            "sls",
            "mjf",
            "sla",
            "dlp",
            "volumetric",
            "lpbf"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "fdm",
                "sls",
                "mjf",
                "sla",
                "dlp",
                "volumetric",
                "lpbf"
              ]
            },
            "buildDirection": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^([+-]?[xyz]|auto)$",
                  "description": "like '+z', or 'auto'"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "[x, y, z]"
                }
              ],
              "description": "the direction layers stack: '+z', a vector, or 'auto'"
            },
            "stiffnessAcrossLayers": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "shearAcrossLayers": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "anisotropic": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "const": "bond"
                }
              ]
            },
            "interlayer": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "minFeature": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overhangs": {
              "type": "boolean"
            },
            "escapeHole": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "mm: smallest powder escape / resin drain hole (default SLS 4, MJF 5, SLA/DLP 3.5)"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How it is made: sets a minimum member, overhang control (FDM, LPBF metal) and the layer-bond check. lpbf = laser powder-bed fusion metal (AlSi10Mg, Ti64, 316L). sls/mjf (PA12, PA11, PA12-GB, TPU) and sla/dlp (resins) get process checks on the delivered part (report 'process': walls, trapped powder or resin, warp-prone panels; resin supports, peel area and suction cups)."
    },
    "durability": {
      "type": "object",
      "description": "Fatigue (load cases with cycles), creep (with hours) and bolt-preload relaxation, reported under 'durability' in verification. Estimates from published printed-polymer data; see loadpath/durability.py for sources and uncertainty.",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "Service temperature, C (default 23)."
        },
        "safetyFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Target fatigue/creep safety factor, on the loads (default 1.5; the fatigue curve is already a >90% survival design curve)."
        },
        "constrain": {
          "type": "boolean",
          "description": "true: the safety-factor search also sizes the part for fatigue and creep (default false: report only)."
        },
        "preloadHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Hours fasteners hold their preload, for relaxation (default 8760)."
        },
        "fatigueStrength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Override: max stress survived for 2e6 cycles, as a share of the material's strength."
        },
        "fatigueSlope": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Override: S-N inverse slope k (life ~ stress^-k)."
        },
        "creepRatio": {
          "type": "number",
          "minimum": 0,
          "description": "Override: creep strain / elastic strain after 1000 h at 23 C."
        },
        "creepExponent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Override: n in creep ~ time^n."
        }
      },
      "additionalProperties": false
    },
    "lattice": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "gyroid",
            "schwarz-p",
            "diamond"
          ],
          "description": "TPMS sheet (default gyroid). Per gram, diamond is the stiffest and strongest, Schwarz P the weakest and has flat ceilings (FDM)."
        },
        "cell": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm per TPMS period (at least 4 x maxWall)"
        },
        "skin": {
          "type": "number",
          "minimum": 0,
          "description": "mm of solid shell; 0 leaves the lattice open. Under a skin, SLS, MJF and resin parts get drain holes"
        },
        "sizing": {
          "enum": [
            "homogenized",
            "solid-stress"
          ],
          "description": "homogenized (default): the core is analyzed as the lattice it will be and each cell sized to safetyFactor; solid-stress: graded from the solid part's stress (quick, but not a sizing)"
        },
        "minWall": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm, where the part idles (at least the process's minFeature)"
        },
        "maxWall": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm; homogenized cells that would need more turn solid"
        },
        "solidAbove": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "(solid-stress) utilization (stress / allowable) above which material stays solid"
        },
        "safetyFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "target safety factor of the lattice walls and skin (default: the study goal's, else 2)"
        },
        "collar": {
          "type": "number",
          "minimum": 0,
          "description": "mm of solid round preserved shapes, keep-outs, supports and loads (default 2)"
        },
        "blend": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm, fillet radius where the lattice meets solid (default maxWall)"
        },
        "drains": {
          "enum": [
            "auto",
            "yes",
            "no"
          ],
          "description": "drain holes into enclosed voids: auto = for powder and resin processes"
        },
        "drainDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm (default the process's escape hole: SLS 4, MJF 5, SLA/DLP 3.5, volumetric 3)"
        },
        "fillPockets": {
          "type": "number",
          "minimum": 0,
          "description": "mm^3: enclosed voids smaller than this are filled solid (default cell^3 / 8)"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "field sampling, mm (default minWall / 2.5)"
        }
      },
      "additionalProperties": false,
      "description": "Optional: fill the delivered part with a stress-graded TPMS lattice."
    },
    "expect": {
      "type": "object",
      "description": "Eval-only pass criteria (loadpath.evals)."
    }
  },
  "required": [
    "designSpace"
  ],
  "x-requireOne": [
    [
      "loadCases"
    ],
    [
      "loads"
    ]
  ],
  "additionalProperties": false,
  "$defs": {
    "box": {
      "type": "object",
      "description": "Axis-aligned box: min/max corners, or center/size.",
      "properties": {
        "type": {
          "const": "box"
        },
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        }
      },
      "required": [
        "type"
      ],
      "x-requireOne": [
        [
          "min",
          "max"
        ],
        [
          "center",
          "size"
        ]
      ],
      "additionalProperties": false
    },
    "cylinder": {
      "type": "object",
      "description": "Cylinder or tube: end points p0/p1, or center/axis/length; radius r, optional rInner.",
      "properties": {
        "type": {
          "enum": [
            "cylinder",
            "tube"
          ]
        },
        "p0": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "p1": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "axis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "[x, y, z]"
            }
          ],
          "description": "'x', 'y', 'z' or a direction vector"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rInner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "r"
      ],
      "x-requireOne": [
        [
          "p0",
          "p1"
        ],
        [
          "center",
          "length"
        ]
      ],
      "additionalProperties": false
    },
    "sphere": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sphere"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "center",
        "r"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "description": "A closed mesh: an STL/3MF/OBJ path relative to the study's folder, or inline stlBase64.",
      "properties": {
        "type": {
          "const": "mesh"
        },
        "path": {
          "type": "string"
        },
        "stlBase64": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "x-requireOne": [
        [
          "path"
        ],
        [
          "stlBase64"
        ]
      ],
      "additionalProperties": false
    },
    "union": {
      "type": "object",
      "description": "Several shapes acting as one region (a servo's four screw bosses).",
      "properties": {
        "type": {
          "const": "union"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "shapes"
      ],
      "additionalProperties": false
    },
    "shape": {
      "title": "a shape object (box, cylinder, tube, sphere, mesh, union)",
      "description": "A shape: box, cylinder (tube), sphere, mesh or union. Units mm.",
      "oneOf": [
        {
          "$ref": "#/$defs/box"
        },
        {
          "$ref": "#/$defs/cylinder"
        },
        {
          "$ref": "#/$defs/sphere"
        },
        {
          "$ref": "#/$defs/mesh"
        },
        {
          "$ref": "#/$defs/union"
        }
      ],
      "x-discriminator": {
        "property": "type",
        "mapping": {
          "box": "#/$defs/box",
          "cylinder": "#/$defs/cylinder",
          "tube": "#/$defs/cylinder",
          "sphere": "#/$defs/sphere",
          "mesh": "#/$defs/mesh",
          "union": "#/$defs/union"
        }
      }
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Name loads and supports refer to."
        },
        "shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false
    },
    "keepOut": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Name loads and supports refer to."
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "bore": {
          "type": "boolean",
          "description": "false: a clearance volume (a mating part, a sweep) that may end against material; it is not checked for closed ends. Default true (false for a pressurized cavity)."
        },
        "wall": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "mm of material kept round it, pinned solid: a duct's or a plenum's skin, with only what is behind it designed (ribs). A pressurized keep-out gets minMember if not set."
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "description": "Where the part is held. A 'region' (a preserve or keepOut id, or one a fastener adds such as 'w1-bore') or an inline 'shape'.",
      "properties": {
        "region": {
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "fix": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(all|pin|[xyz]{1,3})$",
              "description": "'all', 'pin', or the axes held, like 'xz'"
            },
            {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "description": "'all' (default), 'pin' (a cylinder: turns freely), axes like 'xz', or 3 booleans"
        }
      },
      "x-requireOne": [
        [
          "region"
        ],
        [
          "shape"
        ]
      ],
      "additionalProperties": false
    },
    "load": {
      "type": "object",
      "description": "A force (N) and/or a moment (N\u00b7mm, about the region's centroid), or a pressure (MPa) in a keepOut. A 'region' (a preserve or keepOut id, or one a fastener adds such as 'w1-bore') or an inline 'shape'.",
      "properties": {
        "region": {
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "force": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "moment": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "torque": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Alias of moment."
        },
        "distribution": {
          "enum": [
            "uniform",
            "bearing"
          ],
          "description": "'bearing' spreads a force over the half of a bore it pushes on"
        },
        "pressure": {
          "type": "number",
          "description": "MPa gauge (1 bar = 0.1 MPa) inside the keepOut named by 'region' (the fluid's volume), on every wall lining it; negative is a vacuum. A study whose only loads are pressures on sealed cavities needs no supports."
        }
      },
      "x-requireOne": [
        [
          "region"
        ],
        [
          "shape"
        ]
      ],
      "additionalProperties": false
    },
    "loadCase": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "loads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/load"
          },
          "minItems": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "cycles": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Times this load is applied over the part's life: adds a fatigue check (e.g. 1e6 for a servo-driven arm)."
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Hours this load is held over the part's life: adds creep rupture and crept deflection."
        },
        "temperature": {
          "type": "number",
          "description": "C while this load acts (default durability.temperature)."
        }
      },
      "required": [
        "loads"
      ],
      "additionalProperties": false
    },
    "material": {
      "anyOf": [
        {
          "type": "string",
          "description": "A name: pla, petg, abs, asa, tpu, pa-cf, pa12, pa11, resin, resin-tough, alsi10mg, ti64, 316l (aliases such as 'nylon', 'aluminium', 'steel' work)."
        },
        {
          "type": "object",
          "description": "A custom material: E (MPa), nu, strength (MPa), density (g/cm\u00b3).",
          "properties": {
            "name": {
              "type": "string"
            },
            "E": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "nu": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4999
            },
            "strength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "density": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "E",
            "strength",
            "density"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fastener": {
      "type": "object",
      "description": "A bolted joint as an interface: bearing rings or a thread sleeve are preserved, the bore and head path kept clear, and a preload case added. Adds regions <id>-bore, <id>-head, <id>-seat, <id>-face or <id>-thread (and <id>-tap).",
      "properties": {
        "id": {
          "type": "string"
        },
        "size": {
          "enum": [
            "M2",
            "M2.5",
            "M3",
            "M4",
            "M5",
            "M6",
            "M8",
            "M10"
          ]
        },
        "seat": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Centre of the face the head (or the mating part) bears on."
        },
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?[xyz]$",
              "description": "like '-x' or '+z'"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "[x, y, z]"
            }
