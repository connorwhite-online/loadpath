{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loadpath wires brief",
  "description": "`loadpath wires`: a product's cables laid and checked with rod physics (wires.py, rods.py). Each cable is a Cosserat rod with its own bending and twist stiffness, started along the clearance-aware shortest way between its ports and settled against the bodies; checked for bend radius, twist, tension, pinching and connector loads, and followed through a motion (a joint's range, a part's way in).",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "shape": {
            "anyOf": [
              {
                "type": "string",
                "description": "a mesh path (STL/3MF/OBJ/GLB; open or broken meshes are wrapped), a STEP file or an .npz/.vdb SDF"
              },
              {
                "$ref": "#/$defs/shape"
              },
              {
                "type": "object",
                "description": "any exterior through the intake (loadpath.exterior.load_exterior; `loadpath exterior`): a generated or scanned mesh is wrapped watertight, scaled and turned +z up",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "STEP, STL/OBJ/PLY/3MF/GLB/glTF, an .npz or .vdb SDF grid, or file.py[:name] (an SDF function or build123d/CadQuery object)"
                  },
                  "size": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "the real longest extent, mm (a generated mesh comes at unit scale)"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "a factor instead of size (metres to mm: 1000)"
                  },
                  "up": {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$",
                    "description": "the source's up axis (default +y for GLB/glTF, else +z)"
                  },
                  "place": {
                    "enum": [
                      "keep",
                      "center",
                      "origin"
                    ],
                    "description": "keep the source frame (default unless scaled or turned) or centre it on z = 0"
                  },
                  "pitch": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mm, the wrap's grid (default longest extent / 320)"
                  },
                  "wrap": {
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ]
                  },
                  "keep": {
                    "enum": [
                      "largest",
                      "all"
                    ],
                    "description": "bodies kept (default the largest: debris dropped)"
                  },
                  "seal": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mm, holes sealed by the flood wrap (no libigl)"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "inside": {
            "type": "boolean",
            "description": "a cavity the cables must stay in (an exterior)"
          },
          "skin": {
            "type": "number",
            "minimum": 0,
            "description": "with inside: wall thickness kept off"
          },
          "moves": {
            "type": "boolean",
            "description": "goes with the motion"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "shape"
        ],
        "additionalProperties": false
      },
      "description": "what the cables must go round (or stay inside)"
    },
    "wires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cable": {
            "anyOf": [
              {
                "type": "string",
                "description": "a name: awg<N>-<insulation> ('awg26-pvc', 'awg22-silicone'), ffc-<conductors>x<pitch> ('ffc-10x0.5'), fpc-<width>x<thickness>, usb2, coax-<od>"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "wire",
                      "bundle",
                      "cable",
                      "coax",
                      "ffc",
                      "fpc",
                      "round",
                      "flat"
                    ],
                    "description": "wire: one insulated wire; bundle: `wires` of them side by side in a sleeve; cable: `wires` in a jacket; coax; ffc: a flat flexible cable (conductors, pitch); fpc: a flex circuit (width, thickness); round / flat: by its numbers"
                  },
                  "awg": {
                    "type": "number"
                  },
                  "conductorArea": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mm^2, instead of awg"
                  },
                  "insulation": {
                    "enum": [
                      "pvc",
                      "pvc105",
                      "silicone",
                      "ptfe",
                      "fep",
                      "tpe",
                      "xlpe",
                      "pur"
                    ]
                  },
                  "strands": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "solid": {
                    "type": "boolean"
                  },
                  "strandCoupling": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "stiffness over the slipped-strand bound (default 1)"
                  },
                  "wires": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "wall": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "jacket": {
                    "enum": [
                      "pvc",
                      "pvc105",
                      "silicone",
                      "ptfe",
                      "fep",
                      "tpe",
                      "xlpe",
                      "pur"
                    ]
                  },
                  "jacketWall": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "shield": {
                    "type": "boolean"
                  },
                  "od": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "mm across (round cables)"
                  },
                  "core": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "dielectric": {
                    "type": "string"
                  },
                  "conductors": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "pitch": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "thickness": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "copper": {
                    "type": "number",
                    "minimum": 0
                  },
                  "copperFill": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "film": {
                    "enum": [
                      "polyimide",
                      "pet"
                    ]
                  },
                  "bendStiffness": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ],
                    "description": "N mm^2, measured or from a datasheet (wires.stiffness_from_droop); [through the thickness, edgewise] for a flat"
                  },
                  "twistStiffness": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "N mm^2"
                  },
                  "minBendRadius": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "object",
                        "properties": {
                          "static": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "dynamic": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "additionalProperties": false
                      }
                    ],
                    "description": "mm, fixed and flexing; default house rules (3x and 10x a wire's diameter, 10x and 100x a flat's thickness)"
                  },
                  "maxTwist": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "object",
                        "properties": {
                          "static": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "dynamic": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "additionalProperties": false
                      }
                    ],
                    "description": "deg per m"
                  },
                  "gramsPerMeter": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maxTemp": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "from": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "mm: where the cable leaves the connector"
              },
              "direction": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ],
                "description": "the way the cable leaves it"
              },
              "up": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ],
                "description": "a flat cable's face normal there (which way its contacts face)"
              },
              "body": {
                "type": "string",
                "description": "the body the port is on: it moves with it"
              },
              "relief": {
                "type": "number",
                "minimum": 0,
                "description": "mm the cable leaves straight (a boot)"
              },
              "maxPull": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N the connector takes along its axis"
              },
              "maxSide": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N across it"
              },
              "maxMoment": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N mm about it"
              }
            },
            "required": [
              "at",
              "direction"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "mm: where the cable leaves the connector"
              },
              "direction": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ],
                "description": "the way the cable leaves it"
              },
              "up": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ],
                "description": "a flat cable's face normal there (which way its contacts face)"
              },
              "body": {
                "type": "string",
                "description": "the body the port is on: it moves with it"
              },
              "relief": {
                "type": "number",
                "minimum": 0,
                "description": "mm the cable leaves straight (a boot)"
              },
              "maxPull": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N the connector takes along its axis"
              },
              "maxSide": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N across it"
              },
              "maxMoment": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "N mm about it"
              }
            },
            "required": [
              "at",
              "direction"
            ],
            "additionalProperties": false
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "mm, port to port: a cable cut to length. Default: the shortest way round plus slack"
          },
          "slack": {
            "type": "number",
            "minimum": 0,
            "description": "over the route's length (default 0.08)"
          },
          "minLength": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "current": {
            "type": "number",
            "minimum": 0,
            "description": "A: resistance, voltage drop, self-heating"
          },
          "via": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "[x, y, z]"
                },
                "along": {
                  "type": "number",
                  "minimum": 0,
                  "description": "mm along the cable (default: its nearest point)"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "at"
              ],
              "additionalProperties": false
            },
            "description": "clips: points the cable is held at"
          },
          "routes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "ways round to try (default 1)"
          },
          "roll": {
            "type": "boolean",
            "description": "hold the far end's roll about its own axis (default: a flat yes, a round wire no)"
          },
          "segments": {
            "type": "integer",
            "minimum": 8,
            "maximum": 400
          },
          "reach": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "enclosure only: mm the later part must be able to stand out of its place with the cable already plugged in (default 12): room for fingers to mate the connector"
          },
          "plugged": {
            "enum": [
              "before",
              "after"
            ],
            "description": "enclosure only: 'before' (default) the cable is plugged in while the later part is still outside and follows it home; 'after' its connector is reached once the part is in"
          }
        },
        "required": [
          "cable",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "revolute",
            "prismatic",
            "path"
          ]
        },
        "axis": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?[xyz]$"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "[x, y, z]"
            }
          ]
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "degrees (revolute) or mm (prismatic); the cables are laid at 0"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "toward": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ]
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "toward",
              "length"
            ],
            "additionalProperties": false
          },
          "description": "type path: straight legs the moving bodies travel, in order"
        },
        "steps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "description": "what the bodies marked `moves` do; every cable with a port on one is followed through it"
    },
    "gravity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[+-]?[xyz]$"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        }
      ],
      "description": "which way is down; cables then carry their weight"
    },
    "pitch": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "mm: the grid each body's distance field is sampled on (default 0.4)"
    },
    "clearance": {
      "type": "number",
      "minimum": 0,
      "description": "mm kept between a cable and a body"
    },
    "routes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "wiresCollide": {
      "type": "boolean",
      "description": "later cables go round earlier ones (default true; not during a motion)"
    },
    "channels": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "clearance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "write each cable's channel (the tube it occupies over the motion) as an STL"
    }
  },
  "required": [
    "wires"
  ],
  "additionalProperties": false,
  "$defs": {
    "box": {
      "type": "object",
      "description": "Box: min/max corners, or center/size (axis-aligned), or center/size/axes (turned: size along the two axes given and their cross product).",
      "properties": {
        "type": {
          "const": "box"
        },
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "mm: round every edge and corner (axis-aligned boxes; default 0)"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z]"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "the box's x and y axes as vectors (its z is their cross product); with center and size"
        }
      },
      "required": [
        "type"
      ],
      "x-requireOne": [
        [
          "min",
          "max"
        ],
        [
          "center",
          "size"
        ]
      ],
      "additionalProperties": false
    },
    "cylinder": {
      "type": "object",
      "description": "Cylinder or tube: end points p0/p1, or center/axis/length; radius r, optional rInner.",
      "properties": {
        "type": {
          "enum": [
            "cylinder",
            "tube"
          ]
        },
        "p0": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "p1": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "axis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "[x, y, z]"
            }
          ],
          "description": "'x', 'y', 'z' or a direction vector"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rInner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "r"
      ],
      "x-requireOne": [
        [
          "p0",
          "p1"
        ],
        [
          "center",
          "length"
        ]
      ],
      "additionalProperties": false
    },
    "sphere": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sphere"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "center",
        "r"
      ],
      "additionalProperties": false
    },
    "heightfield": {
      "type": "object",
      "description": "One side of a surface given as heights over a plane: the points whose n.x is below (or above) h(u, v), h on a square grid in the plane's axes, bilinear between samples. A stepped or curved parting surface (loadpath split writes these).",
      "properties": {
        "type": {
          "const": "heightfield"
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z]"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "the plane's u and v axes"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "(u, v) of heights[0][0]"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "heights[i][j] = h(u0 + i step, v0 + j step) along normal"
        },
        "side": {
          "enum": [
            "below",
            "above"
          ]
        },
        "offset": {
          "type": "number",
          "description": "moves the surface along normal (mm)"
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
