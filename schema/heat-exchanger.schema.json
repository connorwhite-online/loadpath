{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connorwhite-online/loadpath/schema/heat-exchanger.schema.json",
  "title": "loadpath heat exchanger",
  "description": "A two-fluid sheet-TPMS heat exchanger in any core shape, with headers and ports. Units: mm; duty in L/min or kg/s and \u00b0C.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "core": {
      "$ref": "#/$defs/shape"
    },
    "type": {
      "enum": [
        "gyroid",
        "diamond",
        "schwarz-p"
      ]
    },
    "cell": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "mm per TPMS period (at least 3 x wall)"
    },
    "wall": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "mm, the sheet between the fluids"
    },
    "shell": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "header": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cap": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "mm: how deep each plenum seals off the other fluid's channels at the core's ends (default wall + 1); thinner leaves more core open to flow and fewer dead pockets"
    },
    "portLength": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "headers": {
      "enum": [
        "flat",
        "loft"
      ],
      "description": "flat (default): each plenum an even header depth over its zone; loft: a smooth funnel from the zone to its port (the convex hull of the two), so the outside sweeps from core to port with no flat lid or side walls"
    },
    "headerRibs": {
      "type": "integer",
      "minimum": 0,
      "description": "retired and ignored (with a warning): it stood hand-placed fins on each lofted header that no load sized; the plenum walls are the shell everywhere"
    },
    "exteriorBlend": {
      "type": "number",
      "minimum": 0,
      "description": "mm, fillet radius where the outside of the core, headers and ports meet (default 0: sharp); only adds material outside, the fluid spaces stay as designed"
    },
    "phase": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "mm: shift the TPMS against the core's low corner, which moves where the core's faces cut the channels (a partial channel at an edge starves)"
    },
    "portDiameter": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      ],
      "description": "mm, every port; or one per fluid name, e.g. {\"water\": 8, \"air\": 14} (a gas side's ports set most of its pressure drop)"
    },
    "layout": {
      "enum": [
        "cross",
        "counter"
      ]
    },
    "axes": {
      "type": "string",
      "pattern": "^[xyz]{2}$",
      "description": "cross: A along axes[0], B along axes[1]; counter: A through the ends along axes[0], B's side ports along axes[1]"
    },
    "fluids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "build": {
      "anyOf": [
        {
          "enum": [
            "x",
            "y",
            "z",
            "none"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": false
        }
      ],
      "description": "The axis pointing up while printing (null: no print shaping)."
    },
    "skirt": {
      "type": "boolean"
    },
    "split": {
      "type": "number",
      "exclusiveMinimum": 0.05,
      "exclusiveMaximum": 0.95,
      "description": "the first fluid's share of the void (default 0.5): the sheet moves toward the second. An air side against a liquid wants more, e.g. 0.66"
    },
    "process": {
      "enum": [
        "fdm",
        "lpbf",
        "sls",
        "mjf",
        "sla",
        "dlp"
      ],
      "description": "what builds it (default fdm); sets what is shaped for the build (selfsupport.py). Plenums are round-vaulted and ports round for every process; sls / mjf get no build shaping at all (the powder holds every layer); fdm, lpbf (laser powder-bed metal, SLM / DMLS: AlSi10Mg, Ti64, 316L), sla and dlp give a level bore or vault a round-tipped crown only past the round span they build (lpbf ~8 mm). Only fdm keeps the skirt and port gussets. In lpbf the report's internalCeilings.unbuildableArea must be near zero: nothing inside can be supported."
    },
    "maxPoints": {
      "type": "integer",
      "minimum": 100000,
      "description": "cap on the design grid's points (default 16M, about 270 bytes each at the peak; a design over the free memory is refused): a car-sized core at a 1 mm wall needs about 40M"
    },
    "cleanouts": {
      "type": "integer",
      "minimum": 0,
      "description": "powder clean-out ports per fluid (default 0): each a bore through the outer wall at the point of that fluid's space farthest from every opening, on a boss to tap for a plug; the report lists each and its flat plug for check_networks. With lpbf the report's powder entry says how far powder must travel to get out."
    },
    "cleanoutDiameter": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "mm (default 4.2: an M5 tap drill)"
    },
    "closure": {
      "type": "boolean",
      "description": "with build (default true): channels close gently under core surface that looks up and flare open over plenums below, so no channel ends in a flat ceiling"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fluid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "end": {
            "enum": [
              "in",
              "out"
            ]
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?[xyz]$",
                "description": "like '-x' or '+z'"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "[x, y, z]"
              }
            ],
            "description": "'+x' ... '-z' or a direction vector"
          },
          "minCos": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "window": {
            "type": "object",
            "properties": {
              "axis": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?[xyz]$",
                    "description": "like '-x' or '+z'"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[x, y, z]"
                  }
                ],
                "description": "'+x' ... '-z' or a direction vector"
              },
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              }
            },
            "required": [
              "axis"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fluid",
          "end",
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "step": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "grid, mm (default wall / 3); coarser is faster for a first look"
    },
    "expect": {
      "type": "object",
      "description": "Eval-only pass criteria (loadpath.evals)."
    },
    "envelope": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Instead of a core: the box (mm, x y z) the whole part must fit, ports and headers included. `loadpath heatx --size` then picks the core's size, cell, wall, split, layout and each fluid's port for the duty (sizing.py)."
    },
    "sizing": {
      "type": "object",
      "properties": {
        "process": {
          "enum": [
            "fdm",
            "lpbf",
            "sls",
            "mjf",
            "sla",
            "dlp"
          ]
        },
        "maxPressureDrop": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Pa per fluid name"
        },
        "minEffectiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "targetDuty": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "W"
        },
        "objective": {
          "enum": [
            "mass",
            "effectiveness",
            "pressure"
          ]
        }
      },
      "additionalProperties": false,
      "description": "With envelope: what the sized exchanger must meet, and what to rank by."
    },
    "simulate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "voxel": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "mm (default min(cell/2, port/4, header/3))"
            },
            "closures": {
              "enum": [
                "design",
                "lbm"
              ],
              "description": "design: the rating's laws (Savoldi pressure drop, Reynolds 2023 Nu); lbm: both refitted to LBM gyroid cells (better for thick walls, phi under 0.3)"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "With duty: simulate the whole exchanger (porous core, open headers, both fluids and the wall): flow uniformity, pressure field, temperatures and hot spots, beside the epsilon-NTU rating. Seconds to a few minutes."
    },
    "duty": {
      "type": "object",
      "description": "Optional: rate it. One entry per fluid name, plus 'wall' (a material name or W/m\u00b7K).",
      "properties": {
        "wall": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/dutySide"
      }
    }
  },
  "x-requireOne": [
    [
      "core"
    ],
    [
      "envelope"
    ]
  ],
  "additionalProperties": false,
  "$defs": {
    "box": {
      "type": "object",
      "description": "Box: min/max corners, or center/size (axis-aligned), or center/size/axes (turned: size along the two axes given and their cross product).",
      "properties": {
        "type": {
          "const": "box"
        },
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "mm: round every edge and corner (axis-aligned boxes; default 0)"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z]"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "the box's x and y axes as vectors (its z is their cross product); with center and size"
        }
      },
      "required": [
        "type"
      ],
      "x-requireOne": [
        [
          "min",
          "max"
        ],
        [
          "center",
          "size"
        ]
      ],
      "additionalProperties": false
    },
    "cylinder": {
      "type": "object",
      "description": "Cylinder or tube: end points p0/p1, or center/axis/length; radius r, optional rInner.",
      "properties": {
        "type": {
          "enum": [
            "cylinder",
            "tube"
          ]
        },
        "p0": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "p1": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "axis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "[x, y, z]"
            }
          ],
          "description": "'x', 'y', 'z' or a direction vector"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rInner": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "r"
      ],
      "x-requireOne": [
        [
          "p0",
          "p1"
        ],
        [
          "center",
          "length"
        ]
      ],
      "additionalProperties": false
    },
    "sphere": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sphere"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "center",
        "r"
      ],
      "additionalProperties": false
    },
    "heightfield": {
      "type": "object",
      "description": "One side of a surface given as heights over a plane: the points whose n.x is below (or above) h(u, v), h on a square grid in the plane's axes, bilinear between samples. A stepped or curved parting surface (loadpath split writes these).",
      "properties": {
        "type": {
          "const": "heightfield"
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z]"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[x, y, z]"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "the plane's u and v axes"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "(u, v) of heights[0][0]"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "heights[i][j] = h(u0 + i step, v0 + j step) along normal"
        },
        "side": {
          "enum": [
            "below",
            "above"
          ]
        },
        "offset": {
          "type": "number",
          "description": "moves the surface along normal (mm)"
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "normal",
        "axes",
        "origin",
        "step",
        "heights"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "description": "A closed mesh: an STL/3MF/OBJ path relative to the study's folder (or a STEP file, .step/.stp, tessellated and healed; needs loadpath[step]), or inline stlBase64.",
      "properties": {
        "type": {
          "const": "mesh"
        },
        "path": {
          "type": "string"
        },
        "stlBase64": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "x-requireOne": [
        [
          "path"
        ],
        [
          "stlBase64"
        ]
      ],
      "additionalProperties": false
    },
    "sdf": {
      "type": "object",
      "description": "A sampled signed distance field: an .npz (distance, origin, pitch; mm, negative inside) relative to the study's folder, as loadpath.exterior.save_sdf writes it, or an OpenVDB level set (.vdb, from Houdini, Blender, nTop or `loadpath sdf`). How an SDF tool's shape (libfive, the sdf package, a field graph) comes in.",
      "properties": {
        "type": {
          "const": "sdf"
        },
        "path": {
          "type": "string"
        },
        "shroud": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$",
          "description": "a generated exterior by its key (what a shroud block expands to; `loadpath shroud`)"
        }
      },
      "x-requireOne": [
        [
          "path"
        ],
        [
          "shroud"
        ]
      ],
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "union": {
      "type": "object",
      "description": "Several shapes acting as one region (a servo's four screw bosses).",
      "properties": {
        "type": {
          "const": "union"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "shapes"
      ],
      "additionalProperties": false
    },
    "intersect": {
      "type": "object",
      "description": "Where all the shapes overlap: a half ring is a tube intersected with a box.",
      "properties": {
        "type": {
          "const": "intersect"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 2
        }
      },
      "required": [
        "type",
        "shapes"
      ],
      "additionalProperties": false
    },
    "subtract": {
      "type": "object",
      "description": "The first shape with the others cut away: a ring with a gap is a tube minus a box.",
      "properties": {
        "type": {
          "const": "subtract"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 2
        }
      },
      "required": [
        "type",
        "shapes"
      ],
      "additionalProperties": false
    },
    "shape": {
      "title": "a shape object (box, cylinder, tube, sphere, heightfield, mesh, sdf, union, intersect, subtract)",
      "description": "A shape: box, cylinder (tube), sphere, heightfield, mesh, sdf, union, intersect or subtract. Units mm.",
      "oneOf": [
        {
          "$ref": "#/$defs/box"
        },
        {
          "$ref": "#/$defs/cylinder"
        },
        {
          "$ref": "#/$defs/sphere"
        },
        {
          "$ref": "#/$defs/heightfield"
        },
        {
          "$ref": "#/$defs/mesh"
        },
        {
          "$ref": "#/$defs/sdf"
        },
        {
          "$ref": "#/$defs/union"
        },
        {
          "$ref": "#/$defs/intersect"
        },
        {
          "$ref": "#/$defs/subtract"
        }
      ],
      "x-discriminator": {
        "property": "type",
        "mapping": {
          "box": "#/$defs/box",
          "cylinder": "#/$defs/cylinder",
          "tube": "#/$defs/cylinder",
          "sphere": "#/$defs/sphere",
          "mesh": "#/$defs/mesh",
          "sdf": "#/$defs/sdf",
          "heightfield": "#/$defs/heightfield",
          "union": "#/$defs/union",
          "intersect": "#/$defs/intersect",
          "subtract": "#/$defs/subtract"
        }
      }
    },
    "dutySide": {
      "type": "object",
      "properties": {
        "fluid": {
          "anyOf": [
            {
              "enum": [
                "water",
                "water60",
                "air",
                "glycol50",
                "oil"
              ]
            },
            {
              "type": "object",
              "description": "the fluid's own properties at its working state, SI (boost air at 2 bar, a coolant mix not listed)",
              "properties": {
                "name": {
                  "type": "string"
                },
                "rho": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "cp": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "k": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "mu": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "rho",
                "cp",
                "k",
                "mu"
              ],
              "additionalProperties": false
            }
          ]
        },
        "lPerMin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kgPerS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tIn": {
          "type": "number",
          "description": "\u00b0C. A named fluid (air, water, glycol50) is taken at its own state: this temperature, then the mean of inlet and outlet"
        },
        "pressure": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "bar absolute, for a gas (default 1.013): boost air at 2.5 bar is 2.5x as dense"
        }
      },
      "x-requireOne": [
        [
          "lPerMin"
        ],
        [
          "kgPerS"
        ]
      ],
      "additionalProperties": false
    }
  }
}
