{
  "name": "gripper-finger",
  "description": "A GRIP-like gripper finger, 70 x 16 x 12 mm, pinned at its base, printed in PETG and TPU 95A on a two-material FDM printer. Grip: 20 N spread over the 40 mm contact face, the finger must stay stiff. Poke: the same 20 N on a 4 mm patch (an object's edge) must sink at least 0.3 mm deeper than the spread grip does, so the face conforms. The optimizer decides where the stiff core and the soft pad go. Shows multiMaterial with an indentation requirement.",
  "designSpace": [{"type": "box", "min": [0, -8, -6], "max": [70, 8, 6]}],
  "preserve": [
    {"id": "base-boss", "shape": {"type": "cylinder", "center": [6, 0, 0], "axis": "z", "length": 12, "r": 5.5}},
    {"id": "contact-face", "shape": {"type": "box", "min": [30, 7, -6], "max": [70, 8, 6]}}
  ],
  "keepOut": [
    {"id": "pin", "shape": {"type": "cylinder", "center": [6, 0, 0], "axis": "z", "length": 14, "r": 2.6}}
  ],
  "supports": [{"region": "pin"}, {"shape": {"type": "box", "min": [0, -8, -6], "max": [1, 8, 6]}, "fix": "y"}],
  "loadCases": [
    {"name": "grip", "loads": [{"region": "contact-face", "force": [0, -20, 0]}]},
    {"name": "poke", "loads": [{"shape": {"type": "box", "min": [53, 7, -2], "max": [57, 8, 2]}, "force": [0, -20, 0]}],
     "weight": 0}
  ],
  "process": {"type": "fdm", "buildDirection": "+z"},
  "multiMaterial": {
    "materials": ["petg", "tpu"],
    "assign": [{"region": "base-boss", "material": "petg"}],
    "requirements": [{"case": "poke", "indentation": {"relativeTo": "grip", "atLeast": 0.3}}]
  },
  "goal": {"volumeFraction": 0.4, "safetyFactor": 2.0},
  "minMember": 2.0,
  "resolution": {"maxElements": 20000}
}
