<?xml version="1.0"?>
<robot name="desk_arm">
  <link name="base"/>
  <link name="upper_arm">
    <inertial><origin xyz="0.07 0 0"/><mass value="0.30"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="6e-4" iyz="0" izz="6e-4"/></inertial>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0.06 0 0"/><mass value="0.15"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/></inertial>
  </link>
  <link name="tool">
    <inertial><origin xyz="0.03 0 0"/><mass value="0.10"/>
      <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/></inertial>
  </link>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="upper_arm"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="6.0" velocity="2.0"/></joint>
  <joint name="elbow" type="revolute"><parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.14 0 0"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="2.0" effort="3.0" velocity="3.0"/></joint>
  <joint name="wrist" type="revolute"><parent link="forearm"/><child link="tool"/>
    <origin xyz="0.12 0 0"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="1.5" velocity="4.0"/></joint>
</robot>
