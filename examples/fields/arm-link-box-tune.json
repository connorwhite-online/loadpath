{
 "name": "arm-link-box-tune",
 "description": "FDM-printable hollow arm link: a box section (flanges and side walls of tuned thickness, never under 1 mm) with one 1 mm rib down the middle, so the flat roof of each cell bridges at most 14.5 mm rib to wall and nothing inside needs support. Web width and height and the hollow's width and height are tuned for the lightest link that keeps the arm-link study's safety factor and 0.5 mm deflection, read on the fill-weighted grid like the sandwich.",
 "nodes": {
  "shoulder": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "center": [
     0,
     0,
     0
    ],
    "axis": "z",
    "length": 24,
    "r": 16
   }
  },
  "wrist": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "center": [
     140,
     0,
     0
    ],
    "axis": "z",
    "length": 24,
    "r": 15
   }
  },
  "web": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     0,
     -14.9,
     -8.3
    ],
    "max": [
     140,
     14.9,
     8.3
    ]
   },
   "description": "tuned: half-width and half-height"
  },
  "blob": {
   "op": "union",
   "inputs": [
    "shoulder",
    "wrist",
    "web"
   ],
   "blend": 8
  },
  "slab": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     -20,
     -20,
     -12
    ],
    "max": [
     160,
     20,
     12
    ]
   }
  },
  "envelope": {
   "op": "intersect",
   "inputs": [
    "blob",
    "slab"
   ],
   "blend": 1.5,
   "description": "the blend bulges past the bosses' faces: trim them flat, edges rounded 1.5 mm"
  },
  "bores": {
   "op": "shape",
   "shape": {
    "type": "union",
    "shapes": [
     {
      "type": "cylinder",
      "center": [
       0,
       0,
       0
      ],
      "axis": "z",
      "length": 30,
      "r": 11
     },
     {
      "type": "cylinder",
      "center": [
       140,
       0,
       0
      ],
      "axis": "z",
      "length": 30,
      "r": 11
     }
    ]
   },
   "description": "the two 22 mm bearing seats"
  },
  "channel": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "p0": [
     30,
     0,
     0
    ],
    "p1": [
     110,
     0,
     0
    ],
    "r": 5
   },
   "description": "cable channel"
  },
  "collars": {
   "op": "union",
   "inputs": [
    {
     "op": "shell",
     "input": "bores",
     "side": "outside",
     "thickness": 3
    },
    {
     "op": "shell",
     "input": "channel",
     "side": "outside",
     "thickness": 1.0
    }
   ],
   "description": "solid rings round the bearings, a 1 mm liner round the cable channel"
  },
  "fillet": {
   "op": "remap",
   "input": "nearBore",
   "from": [
    3,
    20
   ],
   "to": [
    2.0,
    0.8
   ]
  },
  "joined": {
   "op": "union",
   "inputs": [
    "shellPart",
    "rib",
    "collars"
   ],
   "blend": "fillet"
  },
  "part": {
   "op": "subtract",
   "inputs": [
    {
     "op": "intersect",
     "inputs": [
      "joined",
      "envelope"
     ]
    },
    "bores",
    "channel"
   ]
  },
  "cavityBox": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     17,
     -13.4,
     -6.3
    ],
    "max": [
     123,
     13.4,
     6.3
    ]
   },
   "description": "tuned: half-width and half-height of the hollow"
  },
  "inner": {
   "op": "offset",
   "input": "envelope",
   "distance": -1.0,
   "description": "walls never under 1 mm"
  },
  "cavity": {
   "op": "intersect",
   "inputs": [
    "cavityBox",
    "inner"
   ]
  },
  "rib": {
   "op": "intersect",
   "inputs": [
    {
     "op": "shape",
     "shape": {
      "type": "box",
      "min": [
       0,
       -0.5,
       -12
      ],
      "max": [
       140,
       0.5,
       12
      ]
     }
    },
    "envelope"
   ],
   "description": "one 1 mm rib down the middle: the roof bridges rib to wall (FDM)"
  },
  "shellPart": {
   "op": "subtract",
   "inputs": [
    "envelope",
    "cavity"
   ]
  },
  "nearBore": {
   "op": "distance",
   "input": "bores"
  }
 },
 "output": "part",
 "material": "pa12",
 "minWall": 0.8,
 "tune": {
  "study": "example:arm-link",
  "analysis": "homogenized",
  "cells": 120000,
  "evaluations": 30,
  "params": [
   {
    "path": "nodes/web/shape/max/1",
    "also": [
     "-nodes/web/shape/min/1"
    ],
    "min": 8,
    "max": 17
   },
   {
    "path": "nodes/web/shape/max/2",
    "also": [
     "-nodes/web/shape/min/2"
    ],
    "min": 5,
    "max": 11
   },
   {
    "path": "nodes/cavityBox/shape/max/1",
    "also": [
     "-nodes/cavityBox/shape/min/1"
    ],
    "min": 3,
    "max": 15
   },
   {
    "path": "nodes/cavityBox/shape/max/2",
    "also": [
     "-nodes/cavityBox/shape/min/2"
    ],
    "min": 2,
    "max": 10
   }
  ]
 }
}