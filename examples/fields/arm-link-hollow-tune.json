{
 "name": "arm-link-hollow-tune",
 "description": "Hollow arm link: the sandwich search (arm-link-sandwich-tune.json) with no core, a stress-graded skin round an empty web whose width and height are tuned with the skin, for the lightest link that keeps the arm-link study's safety factor and 0.5 mm deflection. Analyzed on the same fill-weighted grid as the sandwich (analysis homogenized), so the two compare on equal terms.",
 "nodes": {
  "shoulder": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "center": [
     0,
     0,
     0
    ],
    "axis": "z",
    "length": 24,
    "r": 16
   }
  },
  "wrist": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "center": [
     140,
     0,
     0
    ],
    "axis": "z",
    "length": 24,
    "r": 15
   }
  },
  "web": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     0,
     -13.5,
     -8
    ],
    "max": [
     140,
     13.5,
     8
    ]
   },
   "description": "tuned: half-width and half-height"
  },
  "blob": {
   "op": "union",
   "inputs": [
    "shoulder",
    "wrist",
    "web"
   ],
   "blend": 8
  },
  "slab": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     -20,
     -20,
     -12
    ],
    "max": [
     160,
     20,
     12
    ]
   }
  },
  "envelope": {
   "op": "intersect",
   "inputs": [
    "blob",
    "slab"
   ],
   "blend": 1.5,
   "description": "the blend bulges past the bosses' faces: trim them flat, edges rounded 1.5 mm"
  },
  "bores": {
   "op": "shape",
   "shape": {
    "type": "union",
    "shapes": [
     {
      "type": "cylinder",
      "center": [
       0,
       0,
       0
      ],
      "axis": "z",
      "length": 30,
      "r": 11
     },
     {
      "type": "cylinder",
      "center": [
       140,
       0,
       0
      ],
      "axis": "z",
      "length": 30,
      "r": 11
     }
    ]
   },
   "description": "the two 22 mm bearing seats"
  },
  "channel": {
   "op": "shape",
   "shape": {
    "type": "cylinder",
    "p0": [
     30,
     0,
     0
    ],
    "p1": [
     110,
     0,
     0
    ],
    "r": 5
   },
   "description": "cable channel"
  },
  "maxWeb": {
   "op": "shape",
   "shape": {
    "type": "box",
    "min": [
     0,
     -17,
     -11
    ],
    "max": [
     140,
     17,
     11
    ]
   }
  },
  "maxEnvelope": {
   "op": "intersect",
   "inputs": [
    {
     "op": "union",
     "inputs": [
      "shoulder",
      "wrist",
      "maxWeb"
     ],
     "blend": 8
    },
    "slab"
   ],
   "blend": 1.5
  },
  "maxSolid": {
   "op": "subtract",
   "inputs": [
    "maxEnvelope",
    "bores",
    "channel"
   ]
  },
  "stress": {
   "op": "result",
   "study": "example:arm-link",
   "part": "maxSolid",
   "pitch": 1.0,
   "scale": "peak",
   "description": "von Mises of the largest envelope, worst load case, over its peak"
  },
  "nearBore": {
   "op": "distance",
   "input": "bores"
  },
  "skinWall": {
   "op": "remap",
   "input": "stress",
   "from": [
    0.1,
    0.8
   ],
   "to": [
    0.8,
    4.3
   ],
   "curve": "smoothstep"
  },
  "skin": {
   "op": "shell",
   "input": "envelope",
   "thickness": "skinWall"
  },
  "collars": {
   "op": "union",
   "inputs": [
    {
     "op": "shell",
     "input": "bores",
     "side": "outside",
     "thickness": 3
    },
    {
     "op": "shell",
     "input": "channel",
     "side": "outside",
     "thickness": 1.0
    }
   ],
   "description": "solid rings round the bearings, a 1 mm liner round the cable channel"
  },
  "fillet": {
   "op": "remap",
   "input": "nearBore",
   "from": [
    3,
    20
   ],
   "to": [
    2.0,
    0.8
   ]
  },
  "joined": {
   "op": "union",
   "inputs": [
    "skin",
    "collars"
   ],
   "blend": "fillet"
  },
  "part": {
   "op": "subtract",
   "inputs": [
    {
     "op": "intersect",
     "inputs": [
      "joined",
      "envelope"
     ]
    },
    "bores",
    "channel"
   ]
  }
 },
 "output": "part",
 "mesh": {
  "pitch": 0.3
 },
 "material": "pa12",
 "minWall": 0.8,
 "tune": {
  "study": "example:arm-link",
  "params": [
   {
    "path": "nodes/web/shape/max/1",
    "also": [
     "-nodes/web/shape/min/1"
    ],
    "min": 7,
    "max": 17
   },
   {
    "path": "nodes/web/shape/max/2",
    "also": [
     "-nodes/web/shape/min/2"
    ],
    "min": 5,
    "max": 11
   },
   {
    "path": "nodes/skinWall/to/0",
    "min": 0.8,
    "max": 3.0
   },
   {
    "path": "nodes/skinWall/to/1",
    "min": 1.0,
    "max": 6.0
   }
  ],
  "evaluations": 30,
  "cells": 120000,
  "analysis": "homogenized"
 }
}