<?xml version="1.0"?>
<!-- A four-axis desktop arm (GRIP-sized): base yaw, shoulder, elbow and wrist
     pitch, 1 kg at the gripper. Metres, kg, N·m. At the home pose (every
     joint at 0) the upper arm stands straight up and the forearm reaches
     out along +x; the forearm sits between the upper arm's two cheek plates
     at the elbow and holds the wrist hub between its own two cheeks. -->
<robot name="desk-arm">
  <link name="base">
    <inertial><origin xyz="0 0 0.02"/><mass value="1.2"/>
      <inertia ixx="2e-3" ixy="0" ixz="0" iyy="2e-3" iyz="0" izz="3e-3"/></inertial>
    <collision><origin xyz="0 0 0.02"/><geometry><box size="0.14 0.14 0.04"/></geometry></collision>
  </link>

  <link name="turret">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.6"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="6e-4"/></inertial>
    <collision><origin xyz="0 0 0.03"/><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <collision><origin xyz="0 0.03 0.07"/><geometry><box size="0.036 0.006 0.04"/></geometry></collision>
    <collision><origin xyz="0 -0.03 0.07"/><geometry><box size="0.036 0.006 0.04"/></geometry></collision>
  </link>

  <!-- two 6 mm cheek plates 38 mm apart, rounded at the elbow; the elbow
       motor sits low, by the shoulder, and drives the elbow by belt -->
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.05"/><mass value="0.55"/>
      <inertia ixx="1.8e-3" ixy="0" ixz="0" iyy="1.8e-3" iyz="0" izz="3e-4"/></inertial>
    <collision><origin xyz="0 0.022 0.08"/><geometry><box size="0.036 0.006 0.16"/></geometry></collision>
    <collision><origin xyz="0 -0.022 0.08"/><geometry><box size="0.036 0.006 0.16"/></geometry></collision>
    <collision><origin xyz="0 0.022 0.16" rpy="1.5708 0 0"/><geometry><cylinder radius="0.018" length="0.006"/></geometry></collision>
    <collision><origin xyz="0 -0.022 0.16" rpy="1.5708 0 0"/><geometry><cylinder radius="0.018" length="0.006"/></geometry></collision>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.042 0.05 0.042"/></geometry></collision>
  </link>

  <!-- the part this tutorial designs; its mass includes the wrist servo -->
  <link name="forearm">
    <inertial><origin xyz="0.08 0 0"/><mass value="0.22"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/></inertial>
  </link>

  <!-- a hub between the forearm's cheeks, a stem, and the gripper -->
  <link name="wrist">
    <inertial><origin xyz="0.05 0 0"/><mass value="0.3"/>
      <inertia ixx="2e-4" ixy="0" ixz="0" iyy="3e-4" iyz="0" izz="3e-4"/></inertial>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.014" length="0.024"/></geometry></collision>
    <collision><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.024 0.024"/></geometry></collision>
    <collision><origin xyz="0.075 0 0"/><geometry><box size="0.03 0.06 0.04"/></geometry></collision>
  </link>

  <joint name="j1" type="revolute"><parent link="base"/><child link="turret"/>
    <origin xyz="0 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="6.0" velocity="2.0"/></joint>
  <joint name="j2" type="revolute"><parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="12.0" velocity="1.5"/></joint>
  <joint name="j3" type="revolute"><parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.16"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.0" effort="6.0" velocity="2.0"/></joint>
  <joint name="j4" type="revolute"><parent link="forearm"/><child link="wrist"/>
    <origin xyz="0.14 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="3.0" velocity="4.0"/></joint>
</robot>
