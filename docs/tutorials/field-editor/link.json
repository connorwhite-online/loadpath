{
  "name": "link",
  "description": "A short robot wrist link drawn in the field editor: two bosses and a web smooth-unioned, trimmed flat, a window through the web so it works as two flanges, bearing seats cut sharp. The stress node colours the preview; the tune block finds the lightest web and window that still meet link.study.json.",
  "nodes": {
    "shoulder": {"op": "shape", "shape": {"type": "cylinder", "center": [0, 0, 0], "axis": "z", "length": 20, "r": 13}},
    "wrist": {"op": "shape", "shape": {"type": "cylinder", "center": [80, 0, 0], "axis": "z", "length": 20, "r": 12}},
    "web": {"op": "shape", "shape": {"type": "box", "min": [0, -10, -8], "max": [80, 10, 8]}},
    "blob": {"op": "union", "inputs": ["shoulder", "wrist", "web"], "blend": 8, "description": "bosses and web smooth-unioned"},
    "slab": {"op": "shape", "shape": {"type": "box", "min": [-16, -16, -10], "max": [96, 16, 10]}},
    "envelope": {"op": "intersect", "inputs": ["blob", "slab"], "blend": 1.5, "description": "trim the blend's bulge flat, edges rounded 1.5 mm"},
    "window": {"op": "shape", "shape": {"type": "union", "shapes": [
      {"type": "box", "min": [28, -4, -15], "max": [52, 4, 15]},
      {"type": "cylinder", "center": [28, 0, 0], "axis": "z", "length": 30, "r": 4},
      {"type": "cylinder", "center": [52, 0, 0], "axis": "z", "length": 30, "r": 4}]},
      "description": "a slot through the web: what is left is two flanges, top and bottom in the bending"},
    "frame": {"op": "subtract", "inputs": ["envelope", "window"], "blend": 2, "description": "window edges rounded 2 mm"},
    "bores": {"op": "shape", "shape": {"type": "union", "shapes": [
      {"type": "cylinder", "center": [0, 0, 0], "axis": "z", "length": 26, "r": 8},
      {"type": "cylinder", "center": [80, 0, 0], "axis": "z", "length": 26, "r": 8}]}, "description": "the two 16 mm bearing seats"},
    "part": {"op": "subtract", "inputs": ["frame", "bores"]},
    "stress": {"op": "result", "study": "link.study.json", "part": "part", "pitch": 1.0, "scale": "peak",
               "description": "von Mises of the part under the study, worst case, as a fraction of its peak: the editor's colour"}
  },
  "output": "part",
  "mesh": {"pitch": 0.4},
  "material": "pa12",
  "process": "sls",
  "tune": {
    "study": "link.study.json",
    "params": [
      {"path": "nodes/web/shape/max/1", "also": ["-nodes/web/shape/min/1"], "min": 7, "max": 13},
      {"path": "nodes/web/shape/max/2", "also": ["-nodes/web/shape/min/2"], "min": 5, "max": 10},
      {"path": "nodes/window/shape/shapes/0/max/1",
       "also": ["-nodes/window/shape/shapes/0/min/1", "nodes/window/shape/shapes/1/r", "nodes/window/shape/shapes/2/r"],
       "min": 2, "max": 7}
    ],
    "evaluations": 20
  }
}
